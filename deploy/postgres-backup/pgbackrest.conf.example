[converge]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql

[global]
repo1-type=s3
repo1-path=/converge
repo1-s3-bucket=replace-with-off-host-bucket
repo1-s3-endpoint=replace-with-storage-endpoint
repo1-s3-region=replace-with-region
repo1-s3-uri-style=path
repo1-s3-key=replace-with-access-key
repo1-s3-key-secret=replace-with-secret-key
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=replace-with-long-random-passphrase
repo1-retention-full=7
compress-type=zst
start-fast=y
log-level-file=off
log-level-console=info
