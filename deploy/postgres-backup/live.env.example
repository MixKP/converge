SILO_ROOT_USER=replace-with-access-key
SILO_ROOT_PASSWORD=replace-with-long-random-secret
SILO_CERT_DIR=/absolute/path/to/private/silo-certs
SILO_CA_FILE=/absolute/path/to/private/silo-certs/public.crt
PGBACKREST_CONFIG_FILE=/absolute/path/to/private/pgbackrest-live.conf
PITR_WORKER_TOKEN=replace-with-long-random-token
PITR_WORKER_URL=http://127.0.0.1:8099
