# Set the reachable DNS name or IP of this backup server before first startup.
SILO_HOST=backup.example.com
SILO_ROOT_USER=converge-local
SILO_ROOT_PASSWORD=GENERATE_SILO_PASSWORD
# Use the server's private IP for remote access; restrict access with its firewall.
SILO_BIND_ADDRESS=127.0.0.1
SILO_PORT=9000
SILO_CONSOLE_PORT=9001
