# Choose these yourself before make up.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Generated by make setup. Keep these unchanged after first use.
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
JWT_SECRET=GENERATE_JWT_SECRET
PITR_WORKER_TOKEN=GENERATE_WORKER_TOKEN
PITR_CIPHER_PASS=GENERATE_CIPHER_PASS

# Local default. For separate hosts, copy Silo credentials from .env.silo
# and set SILO_HOST to its reachable DNS name or IP (no https:// prefix).
SILO_ROOT_USER=converge-local
SILO_ROOT_PASSWORD=GENERATE_SILO_PASSWORD
SILO_HOST=silo
SILO_PORT=9000
SILO_CONSOLE_PORT=9011

APP_PORT=8088
APP_BIND_ADDRESS=127.0.0.1
