DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=converge_db

JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL=24h

ADMIN_USERNAME=admin
# Required: set a strong password before seeding. Seeding fails while this is empty.
ADMIN_PASSWORD=

# Local/dev only: seed demo login accounts (student1/student2/parent1, password "password").
# Set to true only in local dev; keep false/unset in shared or production databases.
SEED_DEMO_USERS=false
