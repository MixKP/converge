DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=converge_db

# JWT auth (required to run the API server)
JWT_SECRET=change_me_to_a_long_random_string
# Access-token lifetime as a Go duration (default 24h)
JWT_TTL=24h

# First admin account, created by `make seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
